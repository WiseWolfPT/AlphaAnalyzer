# Frontend Environment Variables Example
# Copy this to .env and fill with your values

# Supabase - Frontend (Safe to expose - only anon key)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe Payment Processing (Publishable key is safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# WARNING: NEVER expose service role key or API keys in frontend!