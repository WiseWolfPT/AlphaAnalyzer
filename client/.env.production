# Production environment variables for Vercel deployment
# These should be set in Vercel's environment variables settings

# IMPORTANT: DO NOT SET VITE_API_URL IN PRODUCTION
# The Vercel proxy handles routing /api/* to the backend automatically
# Setting VITE_API_URL will bypass the proxy and cause CORS errors

# Supabase (if you're using it)
# VITE_SUPABASE_URL=your-supabase-url
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key