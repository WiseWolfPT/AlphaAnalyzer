### REFACTOR #5: Performance - Prefetch em Hover

**Impacto:** Perceived performance -40% latency
**Estimativa:** 2-3 dias

```typescript
// client/src/components/stock/stock-search.tsx

import { useQueryClient } from '@tanstack/react-query';

export const StockSearchResult = ({ stock }: { stock: Stock }) => {
  const queryClient = useQueryClient();

  const handleHover = () => {
    // Prefetch stock detail quando hover
    queryClient.prefetchQuery({
      queryKey: ['stock-detail', stock.symbol],
      queryFn: () => fetchStockDetail(stock.symbol),
      staleTime: 5 * 60 * 1000 // 5 min
    });
  };

  return (
    <Link href={`/stock/${stock.symbol}`}>
      <div
        onMouseEnter={handleHover}
        className="hover:bg-secondary/50 p-4 rounded-lg transition-colors"
      >
        <h3>{stock.name}</h3>
        <p>{stock.symbol}</p>
      </div>
    </Link>
  );
};
```

**Aplicar em:**
- [ ] Search results
- [ ] Stock list cards
- [ ] Transcript list
- [ ] Watchlist items

