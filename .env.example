# ALFALYZER - Environment Variables Template
# =================================================================================================
# SECURITY NOTICE - IMPORTANT!
# NEVER commit the actual .env file to version control!
# This .env.example is a template. Copy it to .env and fill in your actual values.
# 
# Variables WITHOUT VITE_ prefix:
# - Stay on the server (secure)
# - Never exposed to client-side code
# - Used only in backend/server code
#
# Variables WITH VITE_ prefix:
# - Are exposed in client-side JavaScript
# - Should NEVER contain sensitive data
# - Only use for public configuration that's safe to expose
# =================================================================================================

# === SUPABASE CONFIGURATION ===
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# === CLIENT-SIDE SAFE VARIABLES ===
# These are exposed to the browser - use anon key only
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# === API KEYS (Backend Only - Keep Secret) ===
# Financial Data Providers - Get free tiers from:
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Twelve Data: https://twelvedata.com/pricing (800 calls/day free)
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# Financial Modeling Prep: https://financialmodelingprep.com/
FMP_API_KEY=your_fmp_key_here

# Finnhub: https://finnhub.io/register (60 calls/minute free)
FINNHUB_API_KEY=your_finnhub_key_here

# === CACHE CONFIGURATION ===
# Redis URL for production (optional - uses in-memory cache if not provided)
REDIS_URL=redis://localhost:6379

# === AI INTEGRATION ===
# OpenAI API for transcript summaries
OPENAI_API_KEY=your_openai_key_here

# === SERVER CONFIGURATION ===
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# === AUTHENTICATION ===
# SECURITY: Generate strong random keys for production
# Use: openssl rand -base64 32
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters
JWT_ACCESS_SECRET=your_super_secure_access_secret_minimum_32_characters  
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_minimum_32_characters

# === STRIPE PAYMENT ===
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_ANNUAL_PRICE_ID=price_your_annual_price_id

# === PUSH NOTIFICATIONS ===
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@domain.com

# Frontend VAPID public key (safe to expose)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# === DEVELOPMENT OPTIONS ===
# Set to 'demo' to use fallback data during development
# Set to real keys for production testing
# ALPHA_VANTAGE_API_KEY=demo
# TWELVE_DATA_API_KEY=demo
# FMP_API_KEY=demo
# FINNHUB_API_KEY=demo

# === OPTIONAL CONFIGURATIONS ===
# Polygon.io (additional provider): https://polygon.io/
# POLYGON_API_KEY=your_polygon_key_here

# Email Service (for notifications)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password_here

# Cache Configuration
MAX_CACHE_SIZE_MB=512

# Upstash Redis (for rate limiting in production)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Monitoring and Logging
LOG_LEVEL=info

# Error tracking service
# SENTRY_DSN=your_sentry_dsn_here

# =================================================================================================
# HOW TO USE THIS FILE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in all the values with your actual API keys and secrets
# 3. Make sure .env is in your .gitignore (it should be by default)
# 4. NEVER commit the actual .env file to Git!
# =================================================================================================