# ================================================================
# ALFALYZER - CONFIGURAÇÃO DE AMBIENTE COMPLETA
# ================================================================
# Copie este arquivo para .env e preencha com valores reais
# SECURITY WARNING: Nunca commite chaves reais no repositório
# 
# Sincronizado com todas as variáveis encontradas no código
# Atualizado em: 11/07/2025

# ================================================================
# CONFIGURAÇÃO DO SERVIDOR
# ================================================================
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
INSTANCE_ID=alfalyzer-local

# ================================================================
# BASE DE DADOS
# ================================================================
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite://./dev.db
DATABASE_PATH=./dev.db
MIGRATION_MODE=false

# ================================================================
# SUPABASE CONFIGURATION
# ================================================================
# Frontend (Public - safe to expose with VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend (Private - NO VITE_ prefix)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_DB_PASSWORD=your-db-password
USE_SUPABASE=true

# ================================================================
# FINANCIAL DATA API KEYS (Server-side only - NO VITE_ prefix)
# ================================================================
# Alpha Vantage - Fundamental data
ALPHA_VANTAGE_API_KEY=demo

# Twelve Data - Market data
TWELVE_DATA_API_KEY=demo

# Financial Modeling Prep - Advanced analytics
FMP_API_KEY=demo

# Finnhub - Real-time data
FINNHUB_API_KEY=demo

# ================================================================
# STRIPE PAYMENT PROCESSING
# ================================================================
# Frontend (Public)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Backend (Private)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_MONTHLY_PRICE_ID=price_monthly_id
STRIPE_ANNUAL_PRICE_ID=price_annual_id

# ================================================================
# AUTHENTICATION & SECURITY
# ================================================================
# JWT secrets for session management
JWT_ACCESS_SECRET=your-access-secret-key-minimum-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters-long

# Session management
SESSION_COOKIE_NAME=alfalyzer-session
SESSION_DURATION=86400000
ENABLE_SESSION_ROTATION=true
MAX_CONCURRENT_SESSIONS=5
SAME_SITE_POLICY=lax

# Security keys
DATA_ENCRYPTION_SECRET=your-data-encryption-secret-32-chars
TRANSMISSION_ENCRYPTION_SECRET=your-transmission-encryption-secret
AUDIT_ENCRYPTION_SECRET=your-audit-encryption-secret-32-chars

# ================================================================
# CORS & RATE LIMITING
# ================================================================
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ================================================================
# CACHING & REDIS
# ================================================================
CACHE_TYPE=memory
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ================================================================
# LOGGING & MONITORING
# ================================================================
AUDIT_LOG_PATH=./logs/audit.log

# ================================================================
# ADMIN & SECURITY
# ================================================================
ADMIN_EMAIL=admin@alfalyzer.com
WHITELISTED_IPS=127.0.0.1,::1

# ================================================================
# PUSH NOTIFICATIONS
# ================================================================
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ================================================================
# THIRD-PARTY INTEGRATIONS
# ================================================================
# AI Services
ANTHROPIC_API_KEY=your-anthropic-api-key

# Whop Integration
ENABLE_WHOP_INTEGRATION=false
WHOP_APP_ID=your-whop-app-id

# Cost monitoring
COST_ALERT_WEBHOOK=https://your-webhook-url

# ================================================================
# FRONTEND SPECIFIC (VITE_ prefix)
# ================================================================
# API endpoints
VITE_API_URL=http://localhost:3000
VITE_BACKEND_URL=http://localhost:3000

# WebSocket for real-time data
VITE_WS_URL=ws://localhost:3000

# Feature flags
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_PAYMENTS=false
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_NOTIFICATIONS=false

# Localization
VITE_DEFAULT_LANGUAGE=pt
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_REGION=EU

# ================================================================
# DEPLOYMENT CONFIGURATION
# ================================================================
# CDN for static assets
VITE_CDN_URL=https://cdn.alfalyzer.com

# App metadata
VITE_APP_NAME=Alfalyzer
VITE_APP_VERSION=1.0.0

# ================================================================
# DEVELOPMENT TOOLS
# ================================================================
# Bundle analysis
ANALYZE_BUNDLE=false

# Debug settings
DEBUG_LEVEL=info
VITE_HOT_RELOAD=true

# ================================================================
# LINKS ÚTEIS PARA OBTER CHAVES GRATUITAS
# ================================================================
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
# Twelve Data: https://twelvedata.com/apikey
# FMP: https://site.financialmodelingprep.com/developer/docs
# Finnhub: https://finnhub.io/register
# Polygon: https://polygon.io/
# Stripe: https://dashboard.stripe.com/apikeys
# Supabase: https://app.supabase.com/
# Sentry: https://sentry.io/
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
# Whop: https://whop.com/developers