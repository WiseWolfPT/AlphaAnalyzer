# ================================================================
# ALFALYZER - CONFIGURAÇÃO DE AMBIENTE
# ================================================================
# Copie este arquivo para .env e preencha com valores reais
# SECURITY WARNING: Nunca commite chaves reais no repositório
# 
# Criado baseado em: server/config/env.ts
# Fase 0 - Estabilização (11/07/2025)

# ================================================================
# CONFIGURAÇÃO DO SERVIDOR
# ================================================================
NODE_ENV=development
PORT=3000

# ================================================================
# BASE DE DADOS
# ================================================================
# PostgreSQL para produção ou SQLite para desenvolvimento
DATABASE_URL=sqlite://./dev.db
# DATABASE_URL=postgresql://user:password@localhost:5432/alfalyzer

# ================================================================
# SUPABASE CONFIGURATION
# ================================================================
# Frontend (Public - safe to expose with VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend (Private - NO VITE_ prefix)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ================================================================
# FINANCIAL DATA API KEYS (Server-side only - NO VITE_ prefix)
# ================================================================
# Alpha Vantage - Fundamental data
ALPHA_VANTAGE_API_KEY=demo

# Twelve Data - Market data
TWELVE_DATA_API_KEY=demo

# Financial Modeling Prep - Advanced analytics
FMP_API_KEY=demo

# Finnhub - Real-time data
FINNHUB_API_KEY=demo

# Polygon.io - US market data
POLYGON_API_KEY=demo

# ================================================================
# STRIPE PAYMENT PROCESSING
# ================================================================
# Frontend (Public)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Backend (Private)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ================================================================
# AUTHENTICATION & SECURITY
# ================================================================
# JWT secrets for session management
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ACCESS_SECRET=your-access-secret-key
JWT_REFRESH_SECRET=your-refresh-secret-key

# ================================================================
# CORS & RATE LIMITING
# ================================================================
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ================================================================
# LOGGING & MONITORING
# ================================================================
LOG_LEVEL=info
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ================================================================
# OPTIONAL SERVICES
# ================================================================
# Redis for caching
REDIS_URL=redis://localhost:6379

# Email service
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@alfalyzer.com

# OpenAI for AI features
OPENAI_API_KEY=sk-your-openai-key

# ================================================================
# FRONTEND SPECIFIC (VITE_ prefix)
# ================================================================
# API endpoints
VITE_API_URL=http://localhost:3000
VITE_BACKEND_URL=http://localhost:3000

# WebSocket for real-time data
VITE_WS_URL=ws://localhost:3000

# Feature flags
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_PAYMENTS=false
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_NOTIFICATIONS=false

# Localization
VITE_DEFAULT_LANGUAGE=pt
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_REGION=EU

# ================================================================
# DEPLOYMENT CONFIGURATION
# ================================================================
# CDN for static assets
VITE_CDN_URL=https://cdn.alfalyzer.com

# App metadata
VITE_APP_NAME=Alfalyzer
VITE_APP_VERSION=1.0.0

# ================================================================
# DEVELOPMENT TOOLS
# ================================================================
# Bundle analysis
ANALYZE_BUNDLE=false

# Debug settings
DEBUG_LEVEL=info
VITE_HOT_RELOAD=true

# ================================================================
# LINKS ÚTEIS PARA OBTER CHAVES GRATUITAS
# ================================================================
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
# Twelve Data: https://twelvedata.com/apikey
# FMP: https://site.financialmodelingprep.com/developer/docs
# Finnhub: https://finnhub.io/register
# Polygon: https://polygon.io/
# Stripe: https://dashboard.stripe.com/apikeys
# Supabase: https://app.supabase.com/
# Sentry: https://sentry.io/
# OpenAI: https://platform.openai.com/api-keys