# Coolify Environment Variables Template
# Copy this to Coolify's environment variables section

# Server Configuration
NODE_ENV=production
PORT=3001

# Frontend URLs (adjust based on your domain)
ALLOWED_ORIGINS=https://alfalyzer.vercel.app,https://alfalyzer.com,https://www.alfalyzer.com

# Database - Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# API Keys - Financial Data Providers
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FINNHUB_API_KEY=your_finnhub_key
FMP_API_KEY=your_fmp_key
TWELVE_DATA_API_KEY=your_twelve_data_key
POLYGON_API_KEY=your_polygon_key

# Optional - OpenAI for transcripts
OPENAI_API_KEY=your_openai_key

# Optional - Redis (if using external Redis)
# REDIS_URL=redis://your-redis-url

# Security
JWT_SECRET=your_jwt_secret_here

# Monitoring (optional)
# SENTRY_DSN=your_sentry_dsn