# Stripe Configuration for 3-Tier Pricing
# Copy this to .env and fill in your actual Stripe keys

# Basic Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs for 3-Tier Pricing (create these in Stripe Dashboard)
# Starter Plan - €9.99/month, €99/year
STRIPE_STARTER_MONTHLY_PRICE_ID=price_starter_monthly_id
STRIPE_STARTER_YEARLY_PRICE_ID=price_starter_yearly_id

# Pro Plan - €19.99/month, €199/year (Most Popular)
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_id
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_id

# Elite Plan - €39.99/month, €399/year
STRIPE_ELITE_MONTHLY_PRICE_ID=price_elite_monthly_id
STRIPE_ELITE_YEARLY_PRICE_ID=price_elite_yearly_id

# URLs for Stripe redirects
CLIENT_URL=http://localhost:5173

# Instructions for setup:
# 1. Go to https://dashboard.stripe.com
# 2. Create 3 products: Starter, Pro, Elite
# 3. For each product, create 2 prices (monthly and yearly)
# 4. Copy the price IDs and paste them above
# 5. Set up webhook endpoint: https://your-domain.com/api/subscriptions/webhook
# 6. Copy webhook signing secret and paste above

# Price Creation Guide:
# 
# Starter:
# - Monthly: €9.99, recurring monthly, 7-day trial
# - Yearly: €99, recurring yearly, 7-day trial
#
# Pro (Most Popular):
# - Monthly: €19.99, recurring monthly, 7-day trial
# - Yearly: €199, recurring yearly, 7-day trial
#
# Elite:
# - Monthly: €39.99, recurring monthly, 7-day trial
# - Yearly: €399, recurring yearly, 7-day trial