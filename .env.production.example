# Environment
NODE_ENV=production
PORT=3001

# Frontend URLs (Vite exposed - safe)
VITE_API_URL=https://api.alfalyzer.com
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Backend (Private - NO VITE prefix)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Security - Session & JWT (32+ characters required)
SESSION_SECRET=generate_random_64_char_string
JWT_SECRET=generate_random_64_char_string
JWT_ACCESS_SECRET=generate_random_64_char_string
JWT_REFRESH_SECRET=generate_random_64_char_string

# API Keys - Backend Only (NO VITE prefix - secure)
POLYGON_API_KEY=your_polygon_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
TWELVE_DATA_API_KEY=your_twelve_data_api_key
FMP_API_KEY=your_fmp_api_key
FINNHUB_API_KEY=your_finnhub_api_key
FISCAL_AI_API_KEY=your_fiscal_ai_api_key

# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# Stripe Payment Processing (Vite public key is safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Monitoring
HEALTHCHECK_UUID=your_healthcheck_uuid
HEALTHCHECK_URL=https://hc-ping.com/your_uuid

# Cron Security
CRON_SECRET=generate_random_secret

# Market Data API Key (for public endpoint protection)
MARKET_DATA_API_KEY=generate_with_uuidgen

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/alfalyzer

# CORS Configuration
CORS_ORIGIN=https://alfalyzer.vercel.app,https://alfalyzer.com