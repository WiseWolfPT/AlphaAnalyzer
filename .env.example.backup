# Wave 4: Environment Configuration Template
# Copy this file to .env and fill in the real values
# SECURITY WARNING: Never commit real API keys to version control

# =================================================================
# NODE.JS ENVIRONMENT
# =================================================================
NODE_ENV=development
PORT=3001

# =================================================================
# SUPABASE CONFIGURATION (Required for production)
# =================================================================
# Public URLs (safe to expose with VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Private Supabase keys (server-side only - NO VITE_ prefix)
SUPABASE_SERVICE_KEY=your-service-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
DATABASE_URL=postgresql://user:pass@host:port/dbname

# =================================================================
# FINANCIAL DATA API KEYS (All server-side only - NO VITE_ prefix)
# =================================================================
# Finnhub - Primary real-time data provider
FINNHUB_API_KEY=your-finnhub-key-here

# Alpha Vantage - Fundamental data provider
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here

# Financial Modeling Prep - Advanced analytics
FMP_API_KEY=your-fmp-key-here

# Twelve Data - Market data fallback
TWELVE_DATA_API_KEY=your-twelve-data-key-here

# Polygon - US market data backup
POLYGON_API_KEY=your-polygon-key-here

# =================================================================
# STRIPE PAYMENT PROCESSING (Server-side only)
# =================================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# =================================================================
# AI SERVICES (Server-side only)
# =================================================================
# OpenAI for earnings transcript summaries
OPENAI_API_KEY=sk-your-openai-key-here

# =================================================================
# MONITORING & ANALYTICS
# =================================================================
# Sentry for error tracking
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =================================================================
# CACHING & PERFORMANCE
# =================================================================
# Redis for production caching
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# Upstash Redis for serverless
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# =================================================================
# SECURITY & AUTHENTICATION
# =================================================================
# JWT secrets for session management
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key

# CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =================================================================
# EMAIL & NOTIFICATIONS
# =================================================================
# SMTP for transactional emails
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password

# SendGrid alternative
SENDGRID_API_KEY=SG.your-sendgrid-key

# =================================================================
# DEPLOYMENT CONFIGURATION
# =================================================================
# Backend deployment URL (for frontend API calls)
VITE_BACKEND_URL=https://your-backend.railway.app

# WebSocket URL for real-time features
VITE_WS_URL=wss://your-backend.railway.app

# CDN for static assets
VITE_CDN_URL=https://your-cdn.com

# =================================================================
# DEVELOPMENT TOOLS
# =================================================================
# Bundle analyzer
ANALYZE_BUNDLE=false

# Debug logging
DEBUG_LEVEL=info

# Hot reload
VITE_HOT_RELOAD=true

# =================================================================
# FEATURE FLAGS
# =================================================================
# Enable/disable features for different environments
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_PAYMENTS=false
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_NOTIFICATIONS=false

# =================================================================
# LOCALIZATION
# =================================================================
# Default language and currency for Portuguese users
VITE_DEFAULT_LANGUAGE=pt
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_REGION=EU

# =================================================================
# BACKUP & RECOVERY
# =================================================================
# Database backup configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket

# =================================================================
# PERFORMANCE MONITORING
# =================================================================
# New Relic APM
NEW_RELIC_LICENSE_KEY=your-newrelic-key
NEW_RELIC_APP_NAME=Alfalyzer

# LogRocket session recording
VITE_LOGROCKET_APP_ID=your-logrocket-id