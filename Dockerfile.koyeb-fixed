# Fixed Dockerfile for Koyeb - Handles TypeScript path aliases properly
FROM node:20-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++ bash

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./

# Install ALL dependencies (including dev for building)
RUN npm ci

# Copy source code
COPY . .

# Build the server with path alias resolution
RUN npm run build:server || echo "Build step 1 complete"
RUN npx tsc-alias -p tsconfig.server.json || echo "Path alias resolution complete"

# Production stage
FROM node:20-alpine AS production

WORKDIR /app

# Install runtime dependencies only
COPY package*.json ./
RUN npm ci --production

# Copy built files from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/shared ./shared

# Copy environment files
COPY .env.example .env.example

# Create a simple startup script
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'echo "🚀 Starting Alfalyzer API Server"' >> /app/start.sh && \
    echo 'echo "📍 Port: ${PORT:-8000}"' >> /app/start.sh && \
    echo 'echo "🔑 API Keys configured: $(env | grep -c "_API_KEY")"' >> /app/start.sh && \
    echo 'node dist/server/index.js' >> /app/start.sh && \
    chmod +x /app/start.sh

# Set production environment
ENV NODE_ENV=production
ENV SERVE_STATIC=false

# Expose port (Koyeb will override with PORT env var)
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || 8000) + '/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Run the server
CMD ["/app/start.sh"]