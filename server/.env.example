# Copy this file to .env and fill in your API keys
# NEVER commit the .env file with real keys!

# Alpha Vantage API Key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Finnhub API Key  
FINNHUB_API_KEY=your_finnhub_key_here

# Financial Modeling Prep API Key
FMP_API_KEY=your_fmp_key_here

# Twelve Data API Key
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# Polygon.io API Key
POLYGON_API_KEY=your_polygon_key_here

# Fiscal AI API Key
FISCAL_AI_API_KEY=your_fiscal_ai_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Logging Configuration
# Options: ERROR, WARN, INFO, DEBUG, TRACE
# Default: WARN in production, INFO in development
LOG_LEVEL=INFO

# Sentry Error Monitoring (Optional)
# Get your DSN from https://sentry.io after creating a project
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id