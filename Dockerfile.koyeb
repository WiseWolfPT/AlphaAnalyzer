# Simple Dockerfile for Koyeb
FROM node:20-alpine AS koyeb

WORKDIR /app

# Install Python and build dependencies for canvas
RUN apk add --no-cache python3 make g++ cairo-dev pango-dev jpeg-dev giflib-dev

# Copy only the server package.json to avoid canvas dependency
COPY server/simple-server.ts ./server/simple-server.ts

# Create a minimal package.json
RUN echo '{ \
  "name": "alphaanalyzer-backend", \
  "version": "1.0.0", \
  "type": "module", \
  "scripts": { \
    "start": "tsx server/simple-server.ts" \
  } \
}' > package.json

# Install only what we need
RUN npm install express cors dotenv tsx @types/express @types/cors

# Expose port
EXPOSE 3001

# Start server
CMD ["npx", "tsx", "server/simple-server.ts"]