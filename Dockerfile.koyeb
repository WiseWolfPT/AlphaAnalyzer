# Simple Dockerfile for Koyeb - Using koyeb-server.ts
FROM node:20-alpine AS koyeb

WORKDIR /app

# Install Python and build dependencies
RUN apk add --no-cache python3 make g++ cairo-dev pango-dev jpeg-dev giflib-dev

# Copy essential server files
COPY server ./server
COPY shared ./shared
COPY package*.json ./
COPY tsconfig*.json ./

# Create .env file
RUN touch .env

# Install only production dependencies
RUN npm install express cors dotenv tsx axios @types/express @types/cors @supabase/supabase-js zod

# Expose port
EXPOSE 3001

# Use koyeb-production.ts with GET endpoints
CMD ["npx", "tsx", "server/koyeb-production.ts"]