# Simple Dockerfile for Koyeb
FROM node:20-alpine AS koyeb

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (skip prepare script)
RUN npm install --production --ignore-scripts

# Install required production dependencies
RUN npm install express cors dotenv tsx

# Copy server files
COPY server ./server
COPY shared ./shared

# Expose port
EXPOSE 3001

# Start server
CMD ["tsx", "server/simple-server.ts"]