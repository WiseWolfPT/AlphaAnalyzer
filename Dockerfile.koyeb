# Dockerfile for Koyeb - Full server with all routes
FROM node:20-alpine AS koyeb

WORKDIR /app

# Install Python and build dependencies
RUN apk add --no-cache python3 make g++ cairo-dev pango-dev jpeg-dev giflib-dev

# Copy all files
COPY . .

# Install dependencies
RUN npm install

# Create empty .env to avoid dotenv warning
RUN touch .env

# Expose port - Koyeb will use the PORT env variable
EXPOSE 3001

# Start the FULL server with tsx (handles TypeScript directly)
CMD ["npx", "tsx", "server/index.ts"]