# Simple Dockerfile for Koyeb - Fixed startup script
FROM node:20-alpine AS koyeb

WORKDIR /app

# Install Python and build dependencies
RUN apk add --no-cache python3 make g++ cairo-dev pango-dev jpeg-dev giflib-dev bash

# Copy all files (needed for full app)
COPY . .

# Install ALL dependencies (including devDependencies for TypeScript)
RUN npm ci

# Build TypeScript
RUN npx tsc server/koyeb-server.ts --outDir dist --esModuleInterop --skipLibCheck || echo "TypeScript build completed"

# Create startup script
RUN echo '#!/bin/bash' > /app/start.sh && \
    echo 'echo "🚀 Koyeb Startup Script"' >> /app/start.sh && \
    echo 'echo "📍 Port: ${PORT:-8000}"' >> /app/start.sh && \
    echo 'echo "📍 Node: $(node --version)"' >> /app/start.sh && \
    echo 'echo ""' >> /app/start.sh && \
    echo '# Try multiple start methods' >> /app/start.sh && \
    echo 'if [ -f "koyeb-server-with-cache.js" ]; then' >> /app/start.sh && \
    echo '  echo "Starting server with caching and market data..."' >> /app/start.sh && \
    echo '  exec node koyeb-server-with-cache.js' >> /app/start.sh && \
    echo 'elif [ -f "koyeb-full-server.js" ]; then' >> /app/start.sh && \
    echo '  echo "Starting full backend server with market data routes..."' >> /app/start.sh && \
    echo '  exec node koyeb-full-server.js' >> /app/start.sh && \
    echo 'elif [ -f "koyeb-health-server.js" ]; then' >> /app/start.sh && \
    echo '  echo "Starting health server..."' >> /app/start.sh && \
    echo '  exec node koyeb-health-server.js' >> /app/start.sh && \
    echo 'elif [ -f "server/koyeb-server.ts" ]; then' >> /app/start.sh && \
    echo '  echo "Starting koyeb TypeScript server..."' >> /app/start.sh && \
    echo '  exec npx tsx server/koyeb-server.ts' >> /app/start.sh && \
    echo 'else' >> /app/start.sh && \
    echo '  echo "Starting with npm start..."' >> /app/start.sh && \
    echo '  exec npm start' >> /app/start.sh && \
    echo 'fi' >> /app/start.sh && \
    chmod +x /app/start.sh

# Set production environment
ENV NODE_ENV=production

# Expose port (Koyeb sets PORT dynamically)
EXPOSE 3001

# Use the startup script
CMD ["/app/start.sh"]