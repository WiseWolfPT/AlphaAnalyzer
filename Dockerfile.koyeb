# Simple Dockerfile for Koyeb
FROM node:20-alpine AS koyeb

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --production

# Copy server files
COPY server ./server
COPY shared ./shared

# Expose port
EXPOSE 3001

# Install tsx for TypeScript
RUN npm install -g tsx

# Start server
CMD ["tsx", "server/simple-server.ts"]