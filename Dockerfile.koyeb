# Simple Dockerfile for Koyeb
FROM node:20-alpine AS koyeb

WORKDIR /app

# Install Python and build dependencies for canvas
RUN apk add --no-cache python3 make g++ cairo-dev pango-dev jpeg-dev giflib-dev

# Copy server files - multiple options for flexibility
COPY server/koyeb-server.ts ./server/koyeb-server.ts
COPY server/simple-server.ts ./server/simple-server.ts
COPY server/simple.js ./server/simple.js

# Copy Supabase integration files
COPY server/db/supabase-client.ts ./server/db/supabase-client.ts
COPY server/services/supabase-cache-service.ts ./server/services/supabase-cache-service.ts

# Create empty .env to avoid dotenv warning
RUN touch .env

# Create a minimal package.json
RUN echo '{ \
  "name": "alphaanalyzer-backend", \
  "version": "1.0.0", \
  "type": "module", \
  "scripts": { \
    "start": "tsx server/simple-server.ts" \
  } \
}' > package.json

# Install only what we need
RUN npm install express cors dotenv tsx @types/express @types/cors @supabase/supabase-js

# Expose port - Koyeb will use the PORT env variable
EXPOSE 8000

# Start server
CMD ["npx", "tsx", "server/koyeb-server.ts"]