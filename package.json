{
  "name": "alfalyzer",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "PORT=3001 tsx --env-file=.env server/index.ts",
    "frontend": "vite --port 3000",
    "build": "vite build --outDir dist/public",
    "build:server": "tsc -p tsconfig.server.json",
    "build:full": "npm run build && npm run build:server",
    "start": "NODE_ENV=production SERVE_STATIC=true tsx server/index.ts",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --reporter=verbose --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --ignore-path .gitignore --max-warnings 50",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx server/db/migrations.ts up",
    "supabase:seed": "tsx scripts/supabase-seed.ts",
    "health": "curl -s http://localhost:3001/api/health | jq .",
    "logs": "pm2 logs alfalyzer",
    "restart": "pm2 restart alfalyzer",
    "stop": "pm2 stop alfalyzer",
    "deploy": "npm run build && npm run deploy:upload && npm run deploy:restart",
    "deploy:upload": "rsync -avz --delete dist/ root@128.140.45.28:\"/home/teste 1/dist/\"",
    "deploy:restart": "ssh root@128.140.45.28 \"cd '/home/teste 1' && pm2 restart alfalyzer\"",
    "deploy:quick": "npm run build && scp -r dist/* root@128.140.45.28:\"/home/teste 1/dist/\" && ssh root@128.140.45.28 \"pm2 restart alfalyzer\"",
    "ship": "npm run ship:git && npm run deploy",
    "ship:git": "git add . && git commit -m 'chore: deploy to production' && git push origin phase-0-main",
    "ship:safe": "npm run test && npm run ship"
  },
